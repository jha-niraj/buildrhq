{
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    // Declaration emit is off on purpose. Consumers import this package as
    // TypeScript source (`"types": "./src/index.ts"`), so no .d.ts is ever
    // produced — but with `declaration: true` tsc still runs the declaration
    // PORTABILITY check, and better-auth's plugin generics infer types that
    // reference its internal modules and zod's core by path. That trips TS2742
    // on `auth`/`authClient` and the only way to silence it is an explicit
    // annotation, which erases exactly the plugin + additionalFields inference
    // that types `emailOtp.*`, `signIn.magicLink` and `user.onboardingCompleted`.
    "declaration": false,
    "declarationMap": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
