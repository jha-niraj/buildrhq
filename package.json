{
	"name": "starterpack-turbo",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"check-types": "turbo run check-types"
	},
	"devDependencies": {
		"prettier": "^3.7.4",
		"turbo": "^2.6.3",
		"typescript": "5.9.2"
	},
	"pnpm": {
		"peerDependencyRules": {
			"ignoreMissing": [
				"sass"
			]
		},
		"overrides": {
			"next": "16.2.12",
			"react": "19.2.3",
			"react-dom": "19.2.3"
		}
	},
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": ">=20.9"
	}
}
