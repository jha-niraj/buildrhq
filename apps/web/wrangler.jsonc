{
	"$schema": "node_modules/wrangler/config-schema.json",

	// Worker name - this is what shows in the Cloudflare dashboard.
	"name": "shipithq-web",

	// Entry point produced by `opennextjs-cloudflare build`. Do not point this at .next/ -
	// OpenNext compiles the Next server into a Worker bundle at this path.
	"main": ".open-next/worker.js",

	"compatibility_date": "2025-11-01",

	// nodejs_compat enables the Node.js built-in polyfills (crypto, buffer, stream, ...)
	// that the Next server bundle and the Neon driver both need.
	"compatibility_flags": ["nodejs_compat"],

	// Static assets (hashed JS/CSS chunks, fonts, images, prerendered files) are served
	// straight off Cloudflare's CDN rather than through the Worker.
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},

	// ── Incremental cache (R2) ────────────────────────────────────────────────
	// ONE-TIME SETUP before the first deploy:
	//     wrangler r2 bucket create shipithq-next-cache
	//
	// The binding name is REQUIRED to be exactly NEXT_INC_CACHE_R2_BUCKET - that is what
	// r2IncrementalCache in open-next.config.ts looks up.
	//
	// Why this matters here more than anywhere else: every page on this site is statically
	// prerendered at build time. Without a configured incremental cache OpenNext has nowhere
	// to persist or serve that prerendered HTML, so the Worker re-renders each page from
	// scratch on EVERY request (`x-nextjs-cache: MISS` on every hit, multi-second TTFB on a
	// cold start). With it, the prerendered HTML/RSC is read directly from R2.
	"r2_buckets": [
		{
			"bucket_name": "shipithq-next-cache",
			"binding": "NEXT_INC_CACHE_R2_BUCKET"
		}
	],

	"vars": {
		// Namespaces this app's cache entries inside the bucket, so apps/main can share the
		// same bucket later without the two colliding in the keyspace.
		"NEXT_INC_CACHE_R2_PREFIX": "shipithq-web-cache"
	},

	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		}
	}
}
