# ─────────────────────────────────────────────────────────────────────────────
# apps/web — BuildrHQ marketing site (buildrhq.com)
# Public/marketing surface only. No auth API, no email, no payments live here.
# Copy to `.env` and fill real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── App URLs ─────────────────────────────────────────────────────────────────
# This marketing site's own public origin.
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
# The authenticated app deploy. Marketing CTAs + auth-owned paths redirect here.
NEXT_PUBLIC_APP_URL="http://localhost:3004"

# ── Auth (client only) ───────────────────────────────────────────────────────
# The origin that hosts /api/auth (the app). The web auth client reads the shared
# cross-subdomain session from here to toggle "Sign in" ↔ "Go to Dashboard".
NEXT_PUBLIC_AUTH_URL="http://localhost:3004"
BETTER_AUTH_URL="http://localhost:3004"

# ── Database (read-only, for landing platform stats) ─────────────────────────
# Neon serverless Postgres — used by the read-only platform-stats action.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
