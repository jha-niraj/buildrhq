PORT=8080
REDIS_URL=redis://localhost:6379
# Must match WORKER_SECRET / JWT signing in the apps that enqueue jobs.
JWT_SECRET=your-worker-jwt-secret
NODE_ENV=development
# Comma-separated origins allowed to call the worker.
ALLOWED_ORIGINS=http://localhost:3004,http://localhost:3001
DOCKER_ENABLED=true
EXECUTION_TIMEOUT_MS=10000
MAX_MEMORY_MB=128
