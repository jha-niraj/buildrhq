# ─────────────────────────────────────────────────────────────────────────────
# apps/hiring — ShipItHQ recruiter/company side (hiring.shipithq.com)  ·  port 3002
# Copy to `.env` and fill real values. DB + auth secrets must match the other apps.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV="development"

# ── App / cross-app URLs ─────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3002"
NEXT_PUBLIC_HIRING_URL="http://localhost:3002"

# ── Database (shared @repo/db) ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Auth (shared @repo/auth) ─────────────────────────────────────────────────
BETTER_AUTH_URL="http://localhost:3002"
BETTER_AUTH_SECRET="generate-a-long-random-string"
AUTH_COOKIE_DOMAIN=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_SECRET_ID=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_MAIL="ShipItHQ Hiring <noreply@shipithq.com>"

# ── Payments (Dodo — subscription plans) ─────────────────────────────────────
DODO_PAYMENTS_API_KEY=""
DODO_PRO_PRODUCT_ID=""

# ── AI ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
ELEVENLABS_API_KEY=""
