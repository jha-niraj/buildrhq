{
	"$schema": "node_modules/wrangler/config-schema.json",

	// Worker name - this is what shows in the Cloudflare dashboard.
	"name": "shipithq-main",

	// Entry point produced by `opennextjs-cloudflare build`. Do NOT point this at .next/ -
	// OpenNext compiles the Next server into a Worker bundle at this path.
	"main": ".open-next/worker.js",

	"compatibility_date": "2025-11-01",

	// nodejs_compat enables the Node.js built-in polyfills (crypto, buffer, stream, ...)
	// that the Next server bundle, better-auth and the Neon driver all need.
	//
	// global_fetch_strictly_public makes fetch() behave like a browser fetch instead of
	// looping back inside the Worker. This app NEEDS it: middleware.ts resolves the session
	// by fetching its own /api/auth/get-session, and without the flag that subrequest does
	// not resolve to the public route on Workers.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

	// Static assets (hashed JS/CSS chunks, fonts, images, prerendered files) are served
	// straight off Cloudflare's CDN rather than through the Worker.
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},

	// ── Incremental cache (R2) ────────────────────────────────────────────────
	// ONE-TIME SETUP before the first deploy:
	//     wrangler r2 bucket create shipithq-next-cache
	//
	// The binding name must be exactly NEXT_INC_CACHE_R2_BUCKET - that is what
	// r2IncrementalCache in open-next.config.ts looks up.
	//
	// Most of this app is per-request and auth-gated, so the win here is smaller than on
	// the marketing site. It still matters for the routes Next prerenders at build time
	// (/signin, /register, /onboarding, the legal pages): without a cache the Worker
	// re-renders them from scratch on every cold request.
	"r2_buckets": [
		{
			"bucket_name": "shipithq-next-cache",
			"binding": "NEXT_INC_CACHE_R2_BUCKET"
		}
	],

	// ── Service binding: generation worker ────────────────────────────────────
	// Both this app and the generation worker run on Cloudflare, so they talk over
	// a service binding rather than a public fetch to workers.dev. That means the
	// request never leaves Cloudflare's network, there is no URL to keep in sync
	// across environments, and the generation worker does not have to be publicly
	// reachable at all.
	//
	// `service` is the deployed Worker name (see apps/generationworker/wrangler.jsonc).
	"services": [
		{
			"binding": "GENERATION_WORKER",
			"service": "shipithq-generation"
		}
	],

	"vars": {
		// Namespaces this app's cache entries inside the shared bucket so apps/web and
		// apps/main never collide in the keyspace.
		"NEXT_INC_CACHE_R2_PREFIX": "shipithq-main-cache"
	},

	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		}
	}
}
