# ─────────────────────────────────────────────────────────────────────────────
# apps/main — PRODUCTION environment (https://app.buildrhq.com)
#
# This file has TWO roles, which is why the public URLs and the secrets live
# together:
#
#   1. BUILD TIME. `next build` sets NODE_ENV=production, and Next then loads
#      this file automatically (it takes precedence over .env). Every
#      NEXT_PUBLIC_* value below is INLINED into the client bundle here — if the
#      production domains are not in this file, the deployed bundle ships
#      localhost URLs.
#
#   2. RUNTIME. `pnpm deploy` runs
#         wrangler deploy --secrets-file .env.production
#      which uploads these as Cloudflare Worker secrets for the server side to
#      read (DATABASE_URL, BETTER_AUTH_SECRET, API keys, …).
#
# `.env` stays as-is and is what you get locally.
#
# ⚠ DELETE any line you are not setting — do not leave it blank.
#   `--secrets-file` is ADDITIVE (a key you omit keeps its current value), but a
#   key present with an EMPTY value is uploaded as an empty string and will
#   overwrite the real secret in production.
# ─────────────────────────────────────────────────────────────────────────────


# ── App / cross-app URLs ─────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="https://app.buildrhq.com"
NEXT_PUBLIC_APP_URL="https://app.buildrhq.com"
NEXT_PUBLIC_WEB_URL="https://www.buildrhq.com"

# ── Database (Neon serverless Postgres — shared @repo/db) ────────────────────
DATABASE_URL=""
DIRECT_URL=""

# ── Auth (better-auth — shared @repo/auth) ───────────────────────────────────
BETTER_AUTH_URL="https://app.buildrhq.com"
BETTER_AUTH_SECRET=""
NEXTAUTH_URL="https://app.buildrhq.com"
NEXTAUTH_SECRET=""
# Set in production only, to the shared parent domain, to enable cross-subdomain
# session cookies (e.g. ".buildrhq.com"). Leave empty on localhost.
AUTH_COOKIE_DOMAIN=".buildrhq.com"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_SECRET_ID=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="BuildrHQ <noreply@buildrhq.com>"

# ── Payments (Razorpay) ──────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ── AI providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
# Model behind the in-app AI panel (/api/ai/chat). Optional — defaults to gpt-4o-mini.
OPENAI_CHAT_MODEL=""
ANTHROPIC_API_KEY=""
SARVAM_API_KEY=""
EXA_API_KEY=""
FALAI_API_KEY=""
# OpenAI assistant IDs
PATHFINDER_ASSISTANT_ID=""
STUDY_PLAN_ASSISTANT_ID=""
AI_PROJECT_GENERATOR_ASSISTANT_ID=""

# ── ElevenLabs (voice mock interviews) ───────────────────────────────────────
ELEVENLABS_API_KEY=""
ELEVENLABS_AI_KEY=""
NEXT_PUBLIC_MOCK_VOICE_AI_ASSISTANT=""
NEXT_PUBLIC_ELEVENLABS_MOCKVOICE=""
NEXT_PUBLIC_ELEVENLABS_SPRINT_MOCK_AGENT_ID=""
NEXT_PUBLIC_ELEVENLABS_STANDUP_AGENT_ID=""
NEXT_PUBLIC_STANDUP_AGENT_ID=""

# ── Storage ──────────────────────────────────────────────────────────────────
# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Vector search (Upstash) ──────────────────────────────────────────────────
UPSTASH_VECTOR_REST_URL=""
UPSTASH_VECTOR_REST_TOKEN=""

# ── Code-execution worker (coderzworker) ─────────────────────────────────────
WORKER_API_URL=""
GENERATION_WORKER_URL=""
NEXT_PUBLIC_WORKER_URL=""
WORKER_SECRET=""

# ── GitHub integration + cron ────────────────────────────────────────────────
GITHUB_TOKEN=""
GITHUB_NIRAJ_JHA_TOKEN=""
CRON_SECRET=""
